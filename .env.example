# Copy this file to .env next to config.example.json (or your copied config).
# config must explicitly set live.env_file to ".env" to load it.
# Create an API wallet at https://app.hyperliquid.xyz/API and authorize it.
# Paste only that API wallet's private key; never paste a main-wallet key here.
HL_API_PRIVATE_KEY=
# Funded MAIN account address (or an authorized subaccount), not the API address.
HL_ACCOUNT_ADDRESS=
# File contains secrets after editing. Never commit, upload, screenshot, or share .env.
# Priority for the single primary wallet: process env > .env > wallet.local.json.
# Named multi-wallet entries use wallet.local.json only, to avoid key crossover.
# Optional Entropy invitation: https://entropy.io/?r=traderx
# Open it yourself and verify eligibility/binding on Entropy. No automatic binding.
